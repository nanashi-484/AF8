set_input_delay -clock clk  -max 1  [get_ports {in_b[0]}]
set_input_delay -clock clk  -min 0  [get_ports {in_b[0]}]
set_input_delay -clock clk  -max 1  [get_ports acc_clear]
set_input_delay -clock clk  -min 0  [get_ports acc_clear]
set_output_delay -clock clk  -max 1  [get_ports {out_result[7]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[7]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[6]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[6]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[5]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[5]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[4]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[4]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[3]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[3]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[2]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[2]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[1]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[1]}]
set_output_delay -clock clk  -max 1  [get_ports {out_result[0]}]
set_output_delay -clock clk  -min 0  [get_ports {out_result[0]}]
set_input_transition -max 0.5  [get_ports clk]
set_input_transition -min 0.5  [get_ports clk]
set_input_transition -max 0.5  [get_ports rst_n]
set_input_transition -min 0.5  [get_ports rst_n]
set_input_transition -max 0.5  [get_ports {in_a[7]}]
set_input_transition -min 0.5  [get_ports {in_a[7]}]
